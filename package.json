{
  "name": "waterfighter",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:browser": "bun run build && bun --bun playwright test",
    "preview": "bun --bun vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.1",
    "@fontsource-variable/dm-sans": "5.3.0"
  }
}
